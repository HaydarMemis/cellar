# Cellar — environment configuration
#
# Copy this file to `.env.local` (gitignored) and fill in real values to
# activate the real backend / social sign-in. Every variable here is
# OPTIONAL: with none of them set, the app runs entirely on its local,
# on-device dev backend (src/data/community) — fully functional, offline,
# just not shared across devices or people.
#
# IMPORTANT for store builds: `.env.local` is gitignored, so EAS Build never
# sees it. Every EXPO_PUBLIC_ value a release needs must ALSO be created as an
# EAS environment variable for the matching environment (eas.json sets
# `environment` per build profile), e.g.:
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_URL --value https://<ref>.supabase.co --visibility plaintext
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value <anon key> --visibility plaintext
# A release build without them silently runs the local-only dev backend.
#
# All variables must be prefixed EXPO_PUBLIC_ to be readable at runtime in
# the client bundle (see https://docs.expo.dev/guides/environment-variables/)
# — this means NONE of these values may be secret. This project's genuinely
# secret credentials (the Supabase service-role key, the RevenueCat webhook
# auth header) never go here — they live ONLY as Supabase Edge Function
# secrets (`supabase secrets set ...`), never in client code, never in this
# file, never committed. See supabase/functions/*/index.ts's own doc
# comments for exactly which secrets each function needs.

# --- Supabase (real backend: auth, profiles, likes, follows, recipes) -----
# From your Supabase project: Settings -> API.
# Apply the schema with the Supabase CLI: `supabase db push` (reads
# supabase/migrations/*.sql in order) — supabase/schema.sql is a generated,
# human-readable snapshot of the same schema, not a separate source of truth.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Also required for real email/password auth (sign-up confirmation +
# password reset emails to actually work): in the Supabase dashboard ->
# Authentication -> URL Configuration -> Redirect URLs, add
# `cellar://reset-password`, `cellar://auth-callback` and `cellar://` to the allow-list — Supabase
# rejects a redirectTo that isn't explicitly allowed there. See
# app/reset-password.tsx and SupabaseAuthBackend.requestPasswordReset.

# --- Sign in with Apple (iOS) ------------------------------------------
# Set to "true" ONLY after the Apple provider is enabled in Supabase
# (Authentication -> Providers -> Apple; add the iOS bundle id
# com.ecclesia.coctail to "Client IDs"). The button is hidden otherwise.
# Account deletion also revokes Apple tokens: set the Edge Function secrets
# APPLE_TEAM_ID, APPLE_KEY_ID, APPLE_CLIENT_ID (= bundle id), APPLE_PRIVATE_KEY
# with `supabase secrets set` (never here).
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=

# --- Google Sign-In (iOS + Android, native SDK) -------------------------
# Google Cloud Console -> APIs & Services -> Credentials:
#  - a "Web application" OAuth client  -> EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
#    (also paste it into Supabase -> Auth -> Providers -> Google, and enable
#    "Skip nonce checks" there — the iOS SDK adds a nonce the app can't read)
#  - an "iOS" OAuth client (bundle id com.ecclesia.coctail)
#    -> EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID, and its REVERSED client id
#    (com.googleusercontent.apps.XXXX) -> EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME
#  - an "Android" OAuth client (package com.ecclesia.coctail + the SHA-1 of
#    your EAS / Play app-signing certificate). No env var needed for it.
# Add the iOS and Android client ids to Supabase's Google "Client IDs" list.
# The Google button is hidden until these are set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# --- RevenueCat (real billing: monthly/yearly/lifetime Premium) ---------
# RevenueCat -> Project settings -> API keys -> public app-specific keys.
# Without them a RELEASE build shows "purchases unavailable" and can never
# grant Premium (development builds use a local test entitlement).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# The webhook secret REVENUECAT_WEBHOOK_AUTH_HEADER is an Edge Function
# secret (`supabase secrets set`), never a client variable.

# --- Crash reporting (Sentry, optional but recommended) -----------------
# A DSN is a public ingestion key. Without it nothing is sent anywhere.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=production
# Build-time only (EAS env / secrets) for source-map upload:
# SENTRY_ORG=, SENTRY_PROJECT=, SENTRY_AUTH_TOKEN= (secret)

# --- Legal / business identity (Privacy Policy, Terms, Guidelines) -------
# Real values only — never fabricate these. Each renders as an explicit
# "[… not yet configured]" placeholder in-app until set. The "draft" banner
# disappears only when EXPO_PUBLIC_LEGAL_REVIEWED=true AND entity,
# jurisdiction and support email are set.
EXPO_PUBLIC_LEGAL_ENTITY_NAME=
EXPO_PUBLIC_LEGAL_ENTITY_ADDRESS=
EXPO_PUBLIC_LEGAL_JURISDICTION=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_LEGAL_REVIEWED=
EXPO_PUBLIC_LEGAL_EFFECTIVE_DATE=
# Public HTTPS URLs of the hosted documents (store listings; Google Play also
# requires a web page where users can request account deletion).
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_COMMUNITY_GUIDELINES_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
